# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Self-Hosted Overrides (sensible defaults are automatically applied in server.ts & docker-compose.yml):
# SESSION_SECRET="ihr-osint-local-selfhosted-secret-2026"
# OLLAMA_BASE_URL="http://host.docker.internal:11434"
# OLLAMA_MODEL="llama3.2"
# POSTGRES_USER="ihr_osint"
# POSTGRES_PASSWORD="ihr_osint_local_password"
# POSTGRES_DB="ihr_osint_db"
# POSTGRES_HOST="postgres"
# POSTGRES_PORT="5432"
